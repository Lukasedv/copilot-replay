{
  "name": "copilot-replay",
  "version": "0.1.0",
  "description": "Replay a GitHub Copilot CLI session from its events.jsonl at a controllable speed. Built for stage demos — no network, no Copilot service calls.",
  "type": "module",
  "bin": {
    "copilot-replay": "bin/copilot-replay.mjs"
  },
  "main": "src/cli.js",
  "exports": {
    ".": "./src/cli.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "copilot",
    "copilot-cli",
    "replay",
    "demo",
    "terminal",
    "cli",
    "tui",
    "presentation"
  ],
  "author": "Lukas Lundin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukasedv/copilot-replay.git"
  },
  "homepage": "https://github.com/lukasedv/copilot-replay#readme",
  "bugs": {
    "url": "https://github.com/lukasedv/copilot-replay/issues"
  },
  "scripts": {
    "start": "node bin/copilot-replay.mjs",
    "check": "node --check bin/copilot-replay.mjs && for f in src/*.js; do node --check \"$f\" || exit 1; done"
  }
}
